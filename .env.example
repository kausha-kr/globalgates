# Server TLS (disabled by default for local development)
SSL_ENABLED=false
SSL_CERTIFICATE_PATH=file:./config/tls/certificate.pem
SSL_PRIVATE_KEY_PATH=file:./config/tls/private-key.pem

# Database and infrastructure
EC2_HOST=localhost
PSQL_PORT=5432
PSQL_DATABASE=globalgates
PSQL_USERNAME=globalgates
PSQL_PASSWORD=change-me
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PASSWORD=guest

# Authentication
JWT_SECRET=generate-a-long-random-value
OAUTH_BASE_URL=http://localhost:10000
KAKAO_CLIENT_ID=not-configured
KAKAO_CLIENT_SECRET=not-configured
NAVER_CLIENT_ID=not-configured
NAVER_CLIENT_SECRET=not-configured
FACEBOOK_CLIENT_ID=not-configured
FACEBOOK_CLIENT_SECRET=not-configured
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured

# External services
MAIL_USERNAME=not-configured
MAIL_PASSWORD=not-configured
AWS_ACCESS_KEY=not-configured
AWS_SECRET_KEY=not-configured
AWS_BUCKET_NAME=not-configured
AWS_REGION=ap-northeast-2
MESSAGE_API_KEY=not-configured
MESSAGE_API_SECRET_KEY=not-configured
GOOGLE_MAPS_API_KEY=not-configured
BOOTPAY_APPLICATION_ID=not-configured
BOOTPAY_PRIVATE_KEY=not-configured
AI_FASTAPI_BASE_URL=http://127.0.0.1:8000

# React development server
VITE_API_TARGET=http://localhost:10000
